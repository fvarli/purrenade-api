APP_NAME=Purrenade
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.purrenade.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the only supported database. MySQL is not used. See ADR-0004.
#
# Local development currently runs against the native PostgreSQL server on this
# machine. The project/deployment target is PostgreSQL 18.x; the recorded version
# gap is in docs/architecture/versions-and-runtime.md.
#
# Never commit a real password. Copy this file to .env and fill it in locally.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=purrenade
DB_USERNAME=purrenade
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue
#
# `sync` locally: the only queued work in M2 is transactional mail, and running
# it inline means there is nothing extra for a developer to start. The jobs are
# still queue-shaped and dispatched `afterCommit`, which is the APPROVED
# contract (docs/security/authentication.md §3) — so production flips this one
# variable and runs a worker, with no code change.
#
# `database` here without a running worker means verification codes are written
# to the jobs table and never delivered, which is a silent failure: registration
# succeeds and the player waits for a mail that will not arrive.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Local development server -----------------------------------------------
# Laravel's ServeCommand reads these, so `artisan serve` AND `artisan dev` both
# bind correctly with no flags. Port 8000 is deliberately avoided: it is a
# common collision, and is already occupied on some development machines.
# Loopback only — the dev server is never exposed on 0.0.0.0.
SERVER_HOST=127.0.0.1
SERVER_PORT=8410

# --- Reverse proxy ------------------------------------------------------------
# Comma-separated. Local HTTPS terminates at native Nginx on loopback.
# Never '*' — that would let any client forge X-Forwarded-For.
# Production defines its own topology here.
TRUSTED_PROXIES=127.0.0.1

# --- Frontend origin -----------------------------------------------------------
# Where a player's browser actually is. This API sends one kind of link — the
# password-reset link — and it must open a page the FRONTEND serves. Configured
# rather than hardcoded: the .test hostname is a local development fact.
FRONTEND_URL=https://purrenade.test
FRONTEND_PASSWORD_RESET_PATH=/auth/reset-password

# --- Authentication ------------------------------------------------------------
# argon2id, not bcrypt: memory-hard, and no silent truncation at 72 bytes.
# Lowered in phpunit.xml for the test suite only.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Sanctum. Token mode only — no stateful domains, deliberately (ADR-0005).
# Adding one would re-enable cookie authentication against this service.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=prrn_

# Security event log retention, in days.
LOG_SECURITY_DAYS=90
