# Normalize line endings across platforms.
* text=auto eol=lf

*.md        diff=markdown
*.php       diff=php
*.blade.php diff=html

# Binary assets.
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary

# Collapse the lockfile in diffs but keep it in the repository.
composer.lock -diff

# Exclude development-only paths from release archives.
/.github        export-ignore
/tests          export-ignore
/docs           export-ignore
.editorconfig   export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore

# Pinned ANTI-6 replay bundles: byte copies of a web build, verified by
# SHA-256 against their manifest. Never normalised, never diffed.
resources/replay/**/*.mjs        -text -diff
resources/replay/**/golden.json  -text -diff
