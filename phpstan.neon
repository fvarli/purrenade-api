includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests

    # Level 5 is the bootstrap baseline. It is raised deliberately as the
    # codebase grows rather than set aspirationally high and then suppressed
    # with baselines and ignores, which is how static analysis becomes theatre.
    level: 5

    treatPhpDocTypesAsCertain: false

    # Pest registers its global test helpers (`it`, `expect`, `getJson`, …) through
    # composer `autoload.files`, which PHPStan does not execute. Point it at the
    # declarations so tests are analysed properly instead of excluded from the gate.
    scanFiles:
        - vendor/pestphp/pest/src/Functions.php
        - vendor/pestphp/pest/src/Pest.php
    scanDirectories:
        - vendor/pestphp/pest-plugin-laravel/src
